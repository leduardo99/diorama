    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/react-table",
      "@tanstack/table-core"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
