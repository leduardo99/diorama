    "test": "tsx tests/run.ts",
    "test:engine": "tsx tests/run.ts engine",
    "test:docs": "tsx tests/run.ts docs",
    "test:runtime": "tsx tests/run.ts runtime",
    "test:phaser": "tsx tests/run.ts phaser",
    "test:cli": "tsx tests/run.ts cli",
    "test:viewer": "tsx tests/run.ts viewer"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ebay/nice-modal-react": "^1.2.13",
