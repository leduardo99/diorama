    "new-asset": "tsx tools/cli.ts new-asset",
    "new-kit": "tsx tools/cli.ts new-kit",
    "list": "tsx tools/cli.ts list",
    "check": "tsx tools/cli.ts check",
    "check:sample": "tsx tools/cli.ts check examples/soulkeeper --strict",
    "layout": "tsx tools/cli.ts layout",
    "game": "tsx tools/cli.ts game",
    "inspect": "tsx tools/cli.ts inspect",
    "contact": "tsx tools/cli.ts contact",
    "new-outfit-character": "tsx tools/cli.ts new-outfit-character",
    "gear-items": "tsx tools/cli.ts gear-items",
    "scenery-items": "tsx tools/cli.ts scenery-items",
